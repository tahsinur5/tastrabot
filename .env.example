# Copy to `.env` (do not commit `.env`) and fill in values.
#
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#
# Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
#
# Market data
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
#
# Runtime
TZ=America/New_York
#
# App mode
# - aws: cloud mode, no IBKR dependency
# - local: full mode, connects to IB Gateway for IBKR sync
APP_MODE=local
#
# IBKR (local mode only)
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=1
IBKR_TRADING_MODE=paper
